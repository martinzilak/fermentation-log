{
  "name": "ferment-log",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "DEV_USER=${DEV_USER:-dev@example.com} DATA_DIR=${DATA_DIR:-./data} tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "import": "DATA_DIR=${DATA_DIR:-./data} tsx src/server/cli/import.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/standard-validator": "0.4.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.14",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3": false
  }
}
